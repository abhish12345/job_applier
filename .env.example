# ─────────────────────────────────────────────────────────
# LINKEDIN SCRAPER - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# Hashtags to search (comma separated, will search each combo)
LINKEDIN_HASHTAGS="#aiml #hiring,#machinelearning #hiring,#python #hiring,#datascience #hiring,#mlops #hiring,#deeplearning #hiring,#artificialintelligence #hiring"

# Scrape filter: 7 = past week, 14 = past 2 weeks, 30 = past month
LINKEDIN_SCRAPE_DAYS=7

# Max posts to scrape per hashtag search
MAX_POSTS_PER_SEARCH=50

# Pause time between scrolls (seconds) - avoid detection
SCROLL_PAUSE_TIME=3

# ─── YOUR PROFILE (Used by Ollama to write emails) ───────
YOUR_NAME=Jackal
YOUR_ROLE=AI/ML Engineer
YOUR_SKILLS=Python, Machine Learning, Deep Learning, NLP, MLOps, TensorFlow, PyTorch, FastAPI, MongoDB
YOUR_EXPERIENCE=2 years
# Only apply to jobs asking for <= this experience (e.g., 3 means 0-3 years, freshers, etc.)
MAX_TARGET_EXPERIENCE=3
# Match posts containing these domains/skills
TARGET_ROLE_KEYWORDS=machine learning,ai,python,ml,data science,deep learning,nlp,mlops,generative ai,computer vision,llm,artificial intelligence
YOUR_MOBILE=+91-9111212137           # Required — shown in every email signature
YOUR_LINKEDIN=
YOUR_GITHUB=
YOUR_PORTFOLIO=                        # Optional — leave blank if none
RESUME_PATH=assets/resume.pdf

# ─── OLLAMA CONFIGURATION ────────────────────────────────
OLLAMA_BASE_URL=http://10.199.207.232:11434
# Available models: gemma, llama3, mistral, phi3
OLLAMA_MODEL=gemma3:12b

# ─── SMTP EMAIL CONFIGURATION ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=3mr.jackal@gmail.com
# Use Gmail App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
EMAIL_SUBJECT_PREFIX=Application for

# ─── MONGODB CONFIGURATION ───────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=linkedin_scraper

# Collection names
MONGO_POSTS_COLLECTION=scraped_posts
MONGO_EMAILS_COLLECTION=extracted_emails
MONGO_SENT_COLLECTION=sent_emails
MONGO_RESPONSES_COLLECTION=email_responses

# ─── EMAIL FILTERS & SAFETY LIMITS ───────────────────────
# Skip if already mailed this address within N days
EMAIL_COOLDOWN_DAYS=15

# Max emails to send per run (safety limit)
MAX_EMAILS_PER_DAY=30

# Delay between sending emails (seconds) - avoid spam flags
DELAY_BETWEEN_EMAILS=60

# ─── HEADLESS BROWSER ────────────────────────────────────
# true = run browser in background, false = visible browser
HEADLESS=false
